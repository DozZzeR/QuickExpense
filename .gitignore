# Gradle build cache (NOT the wrapper — the wrapper must stay tracked)
.gradle/
build/

# Local configuration file (SDK path, etc.)
local.properties

# Built application files
*.apk
*.aab

# Files for the Dalvik/ART VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Android Studio / IntelliJ specific files
.idea/
*.iml

# Keystore files (for signing) and their passwords — never commit the upload key
*.jks
*.keystore
keystore.properties

# Google Services (e.g., Firebase)
google-services.json

# External native build folder
externalNativeBuild/

# NDK build artifacts
obj/

# Log files
*.log

# OS-specific files
.DS_Store
Thumbs.db

# Stray Windows binaries (installers etc. dropped into the project folder)
*.exe
*.msi
*.winmd

# Crashlytics/Fabric plugin files
crashlytics.properties
crashlytics-build.properties
fabric.properties

# ProGuard generated files and folders
proguard/

# Captures folder (Android Studio)
captures/

# Navigation editor temp files (Android Studio)
navigation/
