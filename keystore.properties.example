# Copy to keystore.properties (gitignored) and fill in. Paths are relative to the project root.
# Keep the keystore file itself OUTSIDE the repo folder or make sure it stays ignored (*.jks).
#
# Create the upload key once (validity 25+ years is what Play expects):
#   keytool -genkeypair -v -keystore ../quickexpense-upload.jks -alias upload #       -keyalg RSA -keysize 4096 -validity 10000
#
# Back up the .jks and both passwords somewhere safe. With Play App Signing a lost upload key
# can be reset via Play Console support, but it takes days.
storeFile=../quickexpense-upload.jks
storePassword=
keyAlias=upload
keyPassword=
