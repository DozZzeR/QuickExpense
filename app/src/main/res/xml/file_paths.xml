<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="export" path="exports/"/>
    <!-- Receipts live in filesDir now, not cacheDir (see ReceiptScanActivity) — the OS can
         clear the cache at any time, which would silently lose photos meant for warranties. -->
    <files-path name="receipts" path="receipts/"/>
</paths>