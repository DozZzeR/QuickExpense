<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon background: the same dark-blue glass as the home-screen widget (widget_bg.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF161A24"
                android:endColor="#FF22344D" />
        </shape>
    </item>
    <!-- Soft highlight top-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.30"
                android:centerY="0.25"
                android:gradientRadius="70dp"
                android:startColor="#22FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
